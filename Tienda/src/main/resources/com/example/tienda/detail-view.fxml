<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tienda.controller.DetailController">
    <center>
        <GridPane BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" prefWidth="100.0" />
                <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" prefWidth="200.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints prefHeight="40.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Text text="Detalle del usuario" GridPane.columnSpan="2" GridPane.halignment="CENTER">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Text>

                <Text text="Nombre:" GridPane.rowIndex="1" />
                <Text fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <GridPane.margin><Insets left="10.0" /></GridPane.margin>
                </Text>

                <Text text="Apellido:" GridPane.rowIndex="2" />
                <Text fx:id="txtApellido" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <GridPane.margin><Insets left="10.0" /></GridPane.margin>
                </Text>

                <Text text="Correo:" GridPane.rowIndex="3" />
                <Text fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <GridPane.margin><Insets left="10.0" /></GridPane.margin>
                </Text>

                <Text text="Perfil:" GridPane.rowIndex="4" />
                <Text fx:id="txtPerfil" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <GridPane.margin><Insets left="10.0" /></GridPane.margin>
                </Text>

                <Button fx:id="btnCerrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Cerrar" GridPane.columnSpan="2" GridPane.rowIndex="5">
                    <GridPane.margin>
                        <Insets left="40.0" right="40.0" />
                    </GridPane.margin>
                </Button>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </GridPane>
    </center>
</BorderPane>